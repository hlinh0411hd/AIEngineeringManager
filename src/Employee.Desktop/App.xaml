<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Employee.Desktop.App">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#EEEAFB" />
  <SolidColorBrush x:Key="Accent" Color="#A879FF" />
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI" />
   <Setter Property="FontSize" Value="13" />
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Background" Value="#111020" />
  </Style>
  <Style TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Center" />
   <Setter Property="Padding" Value="14,9" />
   <Setter Property="Margin" Value="0,0,8,8" />
   <Setter Property="Background" Value="#29253F" />
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="BorderBrush" Value="#49415F" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="MinHeight" Value="36" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Surface" Property="Opacity" Value="0.82" />
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="#A879FF" />
        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="#B8B0CF" />
        <Setter TargetName="Surface" Property="Background" Value="#201D33" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="CaretBrush" Value="#F5F0FF" />
   <Setter Property="SelectionBrush" Value="#7545D6" />
   <Setter Property="SelectionOpacity" Value="0.65" />
   <Setter Property="Padding" Value="10,8" />
   <Setter Property="Margin" Value="0,4,12,10" />
   <Setter Property="Background" Value="#191727" />
   <Setter Property="BorderBrush" Value="#49415F" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True">
     <Setter Property="BorderBrush" Value="#A879FF" />
    </Trigger>
    <Trigger Property="IsReadOnly" Value="True">
     <Setter Property="Background" Value="#201D33" />
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Background" Value="#29253F" />
   <Setter Property="BorderBrush" Value="#655A80" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="Padding" Value="10,8" />
   <Setter Property="Margin" Value="0,4,12,10" />
   <Setter Property="MinWidth" Value="130" />
   <Setter Property="MinHeight" Value="38" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
       <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
           <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#D9C8F5" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Margin="10,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}" />
       <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Border Background="#29253F" BorderBrush="#817098" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
         <ScrollViewer CanContentScroll="True">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#BE9BFF" />
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#BE9BFF" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="#B8B0CF" />
        <Setter TargetName="ComboSurface" Property="Background" Value="#201D33" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Background" Value="#191727" />
   <Setter Property="CaretBrush" Value="#F5F0FF" />
   <Setter Property="BorderBrush" Value="#49415F" />
   <Setter Property="Padding" Value="10,8" />
   <Setter Property="Margin" Value="0,4,12,10" />
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Margin" Value="0,8,14,12" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Background" Value="#1D1A2E" />
   <Setter Property="BorderBrush" Value="#3F3859" />
   <Setter Property="Padding" Value="4" />
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="18,12" />
   <Setter Property="Foreground" Value="#B8B0CF" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Background="Transparent" CornerRadius="10" Margin="4" Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#302943" />
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#493773" />
        <Setter Property="Foreground" Value="#E7D5FF" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="TabSurface" Property="BorderBrush" Value="#A879FF" />
        <Setter TargetName="TabSurface" Property="BorderThickness" Value="1" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WorkspaceTabs" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabControl">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
       <Border Background="#1D1A2E" CornerRadius="12" Margin="0,0,18,0" BorderBrush="#3F3859" BorderThickness="1">
        <DockPanel Margin="8,16">
         <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" Foreground="#9E94B8" FontSize="10" FontWeight="Bold" Margin="14,0,0,16" />
         <StackPanel DockPanel.Dock="Bottom" Margin="14,20,10,4">
          <TextBlock Text="Your workspace. Your AI." FontSize="11" FontWeight="SemiBold" Foreground="#B8B0CF" />
          <TextBlock Text="Manage projects and execution" FontSize="10" Foreground="#9E94B8" Margin="0,5,0,0" TextWrapping="Wrap" />
         </StackPanel>
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
         </ScrollViewer>
        </DockPanel>
       </Border>
       <Border Grid.Column="1" Background="#1D1A2E" CornerRadius="12" BorderBrush="#3F3859" BorderThickness="1">
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="4" TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal" />
       </Border>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="HorizontalScrollBarVisibility" Value="Visible" />
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="AutoGenerateColumns" Value="False" />
   <Setter Property="CanUserAddRows" Value="False" />
   <Setter Property="IsReadOnly" Value="True" />
   <Setter Property="GridLinesVisibility" Value="None" />
   <Setter Property="RowHeaderWidth" Value="0" />
   <Setter Property="BorderBrush" Value="#3F3859" />
   <Setter Property="Background" Value="#1D1A2E" />
   <Setter Property="RowBackground" Value="#1D1A2E" />
   <Setter Property="AlternatingRowBackground" Value="#201D33" />
   <Setter Property="RowHeight" Value="42" />
   <Setter Property="ColumnHeaderHeight" Value="40" />
   <Setter Property="SelectionMode" Value="Single" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#2B2640" />
   <Setter Property="Foreground" Value="#BEB4D7" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Padding" Value="12,9" />
   <Setter Property="BorderThickness" Value="0,0,0,1" />
   <Setter Property="BorderBrush" Value="#3F3859" />
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="12,6" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="DataGridCell">
      <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
       <ContentPresenter VerticalAlignment="Center" />
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#493773" />
     <Setter Property="Foreground" Value="#E7D5FF" />
    </Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True">
     <Setter Property="Background" Value="#51406F" />
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Background" Value="#201D33" />
   <Setter Property="BorderBrush" Value="#3F3859" />
   <Setter Property="Padding" Value="8" />
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Padding" Value="10,8" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Option" Background="#29253F" CornerRadius="5" Padding="{TemplateBinding Padding}">
       <ContentPresenter />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Option" Property="Background" Value="#493773" />
        <Setter Property="Foreground" Value="White" />
       </Trigger>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Option" Property="Background" Value="#51406F" />
        <Setter Property="Foreground" Value="White" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="#B8B0CF" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="DatePicker">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Background" Value="#29253F" />
   <Setter Property="BorderBrush" Value="#655A80" />
   <Setter Property="Padding" Value="4" />
   <Setter Property="Margin" Value="0,4,12,10" />
  </Style>
  <Style TargetType="DatePickerTextBox">
   <Setter Property="Foreground" Value="#EEEAFB" />
   <Setter Property="Background" Value="#191727" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="DatePickerTextBox">
      <Border Background="{TemplateBinding Background}" Padding="6">
       <ScrollViewer x:Name="PART_ContentHost" />
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Calendar">
   <Setter Property="Foreground" Value="#211B32" />
   <Setter Property="Background" Value="#F5F0FF" />
  </Style>
  <Style TargetType="TextBlock" />
  <Style TargetType="Label">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Padding" Value="8,6" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ItemSurface" Property="Background" Value="#302943" />
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="ItemSurface" Property="Background" Value="#493773" />
        <Setter Property="Foreground" Value="#FFFFFF" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#29253F" />
   <Setter Property="Foreground" Value="#F5F0FF" />
   <Setter Property="BorderBrush" Value="#817098" />
   <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style x:Key="DashboardCard" TargetType="Border">
   <Setter Property="Background">
    <Setter.Value>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#262238" />
      <GradientStop Color="#181727" Offset="1" />
     </LinearGradientBrush>
    </Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="#48415E" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="16" />
   <Setter Property="Padding" Value="16" />
   <Setter Property="Margin" Value="0" />
   <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="ContentTabs" TargetType="TabControl">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabControl">
      <Border Background="#100F20">
       <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0" />
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ShellMenuButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="HorizontalContentAlignment" Value="Left" />
   <Setter Property="Padding" Value="17,12" />
   <Setter Property="MinHeight" Value="52" />
   <Setter Property="Margin" Value="0,0,0,3" />
   <Setter Property="FontSize" Value="14" />
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Background" Value="#39304F" />
   <Setter Property="Foreground" Value="#AC7BFF" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ProgressBar">
      <Grid SnapsToDevicePixels="True">
       <Border Background="{TemplateBinding Background}" CornerRadius="5" />
       <Grid x:Name="PART_Track">
        <Border Background="{TemplateBinding Foreground}" CornerRadius="5" HorizontalAlignment="Left" x:Name="PART_Indicator" />
       </Grid>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ShellModeCheck" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Foreground" Value="#DCD3EF" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Border x:Name="ModeBorder" Background="Transparent" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="ModeBorder" Property="Background" Value="#44325F" />
        <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#8D6FC1" />
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#A68BCF" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- Menus (right-click and "More ▾"): the same dark panel and purple accents as the dropdowns. -->
  <Style TargetType="ContextMenu">
   <Setter Property="OverridesDefaultStyle" Value="True" />
   <Setter Property="SnapsToDevicePixels" Value="True" />
   <Setter Property="HasDropShadow" Value="True" />
   <Setter Property="Foreground" Value="#EEEAFB" />
   <Setter Property="FontSize" Value="13" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ContextMenu">
      <Border Background="#29253F" BorderBrush="#817098" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="230">
       <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000" />
       </Border.Effect>
       <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="OverridesDefaultStyle" Value="True" />
   <Setter Property="Foreground" Value="#EEEAFB" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="MenuItem">
      <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="10,7,14,7" Margin="0,1">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="22" />
         <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path x:Name="Check" Data="M1,6 L5,10 12,2" Stroke="#BE9BFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="Collapsed" />
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
       </Trigger>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Row" Property="Background" Value="#3B3358" />
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Row" Property="Background" Value="#7545D6" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="#7D7594" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Separator">
   <Setter Property="OverridesDefaultStyle" Value="True" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Separator">
      <Border Height="1" Background="#46405E" Margin="8,5" />
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Application.Resources>
</Application>