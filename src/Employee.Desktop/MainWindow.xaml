          </DataGrid.Columns>
         </DataGrid>
         <TextBlock Text="Click a row (or Details) for the model list, usage, rating and permission settings. Changes there apply immediately." Foreground="#B8B0CF" Margin="0,4,0,12" />
         <Expander Header="CLI Tool API connection" IsExpanded="False">
          <StackPanel Margin="0,8,0,4">
           <TextBlock Text="The aihub address that detects agents and probes models. Plain http is accepted only for this computer; use https for another host. The token is protected when saved." TextWrapping="Wrap" Foreground="#B8B0CF" Margin="0,0,0,6" />
           <WrapPanel>
            <StackPanel>
             <TextBlock Text="API address" />
             <TextBox x:Name="CliToolApiUrl" Width="300" ToolTip="Example: http://127.0.0.1:4777. Plain http is accepted only for this computer; use https for another host." />
            </StackPanel>
            <StackPanel Margin="10,0,0,0">
             <TextBlock Text="API token (optional, protected when saved)" />
             <PasswordBox x:Name="CliToolApiToken" Width="260" />
            </StackPanel>
            <CheckBox x:Name="ClearCliToolApiToken" Content="Clear saved token" VerticalAlignment="Bottom" Margin="10,0,0,8" />
            <Button Content="Save CLI Tool API" Click="SaveCliToolApi" VerticalAlignment="Bottom" Margin="10,0,0,8" />
           </WrapPanel>
          </StackPanel>
         </Expander>
         <Expander x:Name="AdvancedAiSettings" Header="Advanced: routing, ratings, provider options and model catalog" IsExpanded="False">
          <StackPanel Margin="0,8,0,4">
         <TextBlock Text="Deterministic orchestration" Margin="0,18,0,0" FontSize="22" FontWeight="SemiBold" />
         <TextBlock Text="Automatic routes and falls back between allowed models. SemiAutomatic proposes and waits for approval. Manual requires your selection. No paid API fallback is added by the manager." TextWrapping="Wrap" Margin="0,10,0,20" />
         <WrapPanel>
          <StackPanel>
           <TextBlock Text="Routing mode" />
           <ComboBox x:Name="RoutingModeChoice" />
          </StackPanel>
          <StackPanel>
           <TextBlock Text="Attempts per step" ToolTip="Maximum AI runs for each step, including retries and runs that finish reported missing work (1-100). Separate from session/global usage limits." />
           <StackPanel Orientation="Horizontal">
            <TextBox x:Name="MaxAttempts" Width="150" />
            <CheckBox x:Name="UnlimitedAttempts" Content="Unlimited" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="A step keeps running until it reports the work done. It still stops when two runs in a row make no progress, or when you stop it." Checked="UnlimitedAttemptsChanged" Unchecked="UnlimitedAttemptsChanged" />
           </StackPanel>
          </StackPanel>
          <StackPanel>
           <TextBlock Text="Timeout (seconds)" />
           <TextBox x:Name="TimeoutSeconds" Width="150" />
          </StackPanel>
         </WrapPanel>
         <Button Content="Save orchestration settings" Click="SaveSettings" HorizontalAlignment="Left" Background="#7545D6" Foreground="White" />
         <WrapPanel>
          <StackPanel>
           <TextBlock Text="Usage level" />
           <ComboBox x:Name="UsageLevelChoice" Width="180" ToolTip="Auto: lowest expected usage to an accepted result (counts send-backs). Low: lowest-rated model that can do the step. Medium: a middle model. High: an upper model. Highest: the top-rated model for the work type." />
          </StackPanel>
          <CheckBox x:Name="LearnFromHistory" Content="Use measured model history" />
         </WrapPanel>
         <TextBlock Text="Only independent project folders run together. Ollama uses one local slot. Learned offset: rating points learned per model and work type from your ratings, approvals, send-backs and failed runs, compared at each step's difficulty. It fades over time (half weight after 30 days) and stays within ±12." TextWrapping="Wrap" />
         <WrapPanel>
          <Button Content="Save model selection" Click="SavePerformanceSettings" />
          <Button Content="Refresh performance" Click="RefreshPerformanceClick" />
          <Button Content="Reset learning" Click="ResetLearning" ToolTip="Ignore every result judged so far; models go back to their ratings. History is kept." />
         </WrapPanel>
         <TextBlock Text="Model ratings" FontWeight="SemiBold" Margin="0,12,0,4" />
         <TextBlock Text="Routing uses each model's rating for the step's work type, adjusted by measured runs and your approvals/ratings. Ratings in model-ratings.json (data folder) override the built-in table; a ratings URL is refreshed automatically once a day." TextWrapping="Wrap" />
         <TextBlock x:Name="RatingsStatus" TextWrapping="Wrap" Margin="0,4" />
<WrapPanel>
           <TextBox x:Name="RatingsUrl" Width="420" ToolTip="http(s) URL of a JSON ratings file (see Open ratings file for format)" />
           <Button Content="Update ratings now" Click="UpdateRatingsNow" />
           <Button x:Name="UpdateWebRatingsAdvancedButton" Content="Auto-update from websites" Click="UpdateRatingsFromWeb" ToolTip="Consult public benchmark and pricing websites to update usage rank and quality for agent models" />
           <Button Content="Open ratings file" Click="OpenRatingsFile" />
           <Button Content="Reload ratings file" Click="ReloadRatings" />
          </WrapPanel>
          <CheckBox x:Name="AutoRefreshWebRatings" Content="Refresh web ratings automatically once a day" Margin="0,6,0,4" Checked="AutoRefreshWebRatingsChanged" Unchecked="AutoRefreshWebRatingsChanged" />
         <StackPanel>
          <TextBlock Text="Global calls/day (0 = unlimited)" />
          <TextBox x:Name="DailyCallLimit" Width="180" />
         </StackPanel>
         <Button Content="Save usage limits" Click="SaveAIBudgetSettings" />
         <DataGrid x:Name="PerformanceGrid" Height="220">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="85" />
           <DataGridTextColumn Header="Model" Binding="{Binding ModelDisplay}" Width="*" />
           <DataGridTextColumn Header="Work type" Binding="{Binding Capability}" Width="120" />
           <DataGridTextColumn Header="Runs" Binding="{Binding Samples}" Width="55" />
           <DataGridTextColumn Header="Success %" Binding="{Binding SuccessPercent,StringFormat=F0}" Width="75" />
           <DataGridTextColumn Header="Good" Binding="{Binding Good}" Width="50" />
           <DataGridTextColumn Header="Poor" Binding="{Binding Poor}" Width="50" />
           <DataGridTextColumn Header="Avg s" Binding="{Binding AverageSeconds}" Width="65" />
           <DataGridTextColumn Header="Learned offset" Binding="{Binding LearnedOffset,StringFormat=+0.0;-0.0;0}" Width="105" />
          </DataGrid.Columns>
         </DataGrid>
         <TextBlock Text="Provider permissions, path and optional connection details" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,8" />
         <TextBlock Text="Providers start disabled. Enable a provider, keep at least one permitted model and choose task access before running. TextOnly providers cannot use project tools. Codex uses a read-only or workspace-write sandbox; CLI safety setup must work. Project access is not a confidentiality boundary: review provider configuration and project content. Phase 1 never grants full-access flags." TextWrapping="Wrap" />
         <Grid Margin="0,15,0,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="150" />
           <ColumnDefinition />
           <ColumnDefinition Width="100" />
          </Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="Provider settings" />
           <ComboBox x:Name="ProviderChoice" SelectionChanged="ProviderSelected" />
          </StackPanel>
          <StackPanel Grid.Column="1">
           <TextBlock x:Name="ProviderExeLabel" Text="Executable path (empty = PATH)" />
           <TextBox x:Name="ProviderExe" ToolTip="For Responses API, enter the API root URL, such as https://codex.fosta.app/v1. The app adds /responses." />
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="Priority (0-100, higher runs first)" />
           <TextBox x:Name="ProviderPriority" />
          </StackPanel>
         </Grid>
         <WrapPanel>
          <CheckBox x:Name="ProviderEnabled" Content="Allow this provider" />
          <CheckBox x:Name="ProviderWrite" Content="Allow project writes (sandbox / reviewed proposals)" />
          <Button Content="Save provider" Click="SaveProvider" />
         </WrapPanel>
          <StackPanel x:Name="CustomCliSettingsPanel" Visibility="Collapsed" Margin="0,8,0,8">
           <TextBlock Text="Custom CLI agent — configure a headless command that reads the prompt from stdin, or include {prompt} in an argument. {model} is replaced with the selected model ID. Detection does not start the executable. Only TextOnly tasks are routed here; the manager does not provide a project path or project files. The process still runs with this Windows account's permissions, so use an agent you trust." TextWrapping="Wrap" Margin="0,4,0,8" />
           <TextBlock Text="Arguments (JSON string array)" />
           <TextBox x:Name="ProviderArguments" Text="[]" />
           <WrapPanel Margin="0,6,0,0">
            <StackPanel>
             <TextBlock Text="API-key environment variable" />
             <TextBox x:Name="ProviderApiKeyVariable" Text="OPENAI_API_KEY" Width="220" ToolTip="Supported: OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY, OPENROUTER_API_KEY, AZURE_OPENAI_API_KEY, DEEPSEEK_API_KEY, MISTRAL_API_KEY, XAI_API_KEY, GROQ_API_KEY, TOGETHER_API_KEY, FIREWORKS_API_KEY" />
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
             <TextBlock Text="API key (protected when saved; optional)" />
             <PasswordBox x:Name="ProviderApiKey" Width="300" />
            </StackPanel>
            <CheckBox x:Name="ClearProviderApiKey" Content="Clear saved key" VerticalAlignment="Bottom" Margin="8,0,0,8" />
           </WrapPanel>
           <TextBlock x:Name="ProviderApiKeyStatus" TextWrapping="Wrap" Foreground="#B8B0CF" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel x:Name="ResponsesApiSettingsPanel" Visibility="Collapsed" Margin="0,8,0,8">
           <TextBlock Text="OpenAI-compatible Responses API. Enter the API root in Base URL (for example https://codex.fosta.app/v1); the app appends /responses and checks /models without making an inference call. Add an exact model ID if the service does not provide a /models list. API key is protected with Windows DPAPI." TextWrapping="Wrap" Margin="0,4,0,8" />
           <WrapPanel>
            <StackPanel>
             <TextBlock Text="API key (protected when saved)" />
             <PasswordBox x:Name="ResponsesApiKey" Width="300" />
            </StackPanel>
            <CheckBox x:Name="ClearResponsesApiKey" Content="Clear saved key" VerticalAlignment="Bottom" Margin="8,0,0,8" />
           </WrapPanel>
           <TextBlock x:Name="ResponsesApiKeyStatus" TextWrapping="Wrap" Foreground="#B8B0CF" Margin="0,4,0,0" />
          </StackPanel>
         <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#B8B0CF" Margin="0,8,0,8" x:Name="ModelDiscoveryNote" />
         <Grid>
          <Grid.RowDefinitions>
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Model catalog: read from provider metadata or entered manually. Each model's source is shown below; being in the catalog does not guarantee your account can use it. A blank ID uses the CLI default; Responses API requires an exact model ID." TextWrapping="Wrap" Foreground="#B8B0CF" />
          <WrapPanel Grid.Row="1" Margin="0,8,0,0">
           <TextBox x:Name="NewModel" Width="230" ToolTip="Exact model ID, or empty for CLI default (not for Responses API)" />
           <ComboBox x:Name="ModelKind" />
           <CheckBox x:Name="ModelPrimaryRole" Content="Primary for selected task type" ToolTip="Unchecked assigns this model as a backup for the selected task type." />
           <Button Content="Save model role for task type" Click="AddModel" />
           <Button Content="Remove selected model" Click="RemoveModel" />
           <Button Content="Evaluate selected Ollama model" Click="EvaluateModel" />
          </WrapPanel>
<WrapPanel Grid.Row="2">
            <TextBlock Text="Quality rank" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox x:Name="ModelQuality" Text="50" Width="70" />
            <TextBlock Text="Cost rank" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox x:Name="ModelCost" Text="50" Width="70" />
            <CheckBox x:Name="ModelBlocked" Content="Blocked" />
            <Button Content="Save selected model preferences" Click="SaveModelPreferences" />
            <Button x:Name="ResetModelRatingButton" Content="Reset to automatic rating" Click="ResetSelectedModelRating" IsEnabled="False" ToolTip="Clear manual user rating so this model uses web or built-in ratings again" />
           </WrapPanel>
          <DataGrid Grid.Row="3" x:Name="ModelGrid" SelectionChanged="ModelSelected" Height="260" LoadingRow="ModelGridLoadingRow">
           <DataGrid.Columns>
            <DataGridTextColumn Header="Model ID (blank = CLI default)" Binding="{Binding Id}" Width="*" />
            <DataGridTextColumn Header="Allowed task types" Binding="{Binding AllowedTaskTypes}" Width="220" />
            <DataGridTextColumn Header="Quality" Binding="{Binding EffectiveQuality}" Width="90" />
            <DataGridTextColumn Header="Usage rank" Binding="{Binding EffectiveCostRank}" Width="90" />
            <DataGridTextColumn Header="Rating source" Binding="{Binding RatingSource}" Width="230" />
            <DataGridCheckBoxColumn Header="Blocked" Binding="{Binding Blocked}" Width="80" />
            <DataGridTextColumn Header="Model source / verification" Binding="{Binding VerificationDisplay}" Width="320" />
           </DataGrid.Columns>
          </DataGrid>
         </Grid>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Local AI" MinWidth="170" x:Name="SettingsLocalSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <TextBlock Text="Only models/work types that pass evaluation are routed. Advanced JSON/reasoning results never grant coding or planning permission." TextWrapping="Wrap" Margin="0,10,0,15" />
         <ComboBox x:Name="LocalModelChoice" Width="350" HorizontalAlignment="Left" />
         <WrapPanel>
          <Button Content="Evaluate Classification / Extraction" Click="EvaluateLocalStandard" />
          <Button Content="Evaluate JSON / Reasoning" Click="EvaluateLocalAdvanced" />
          <Button Content="Read VRAM metadata" Click="ReadGpuMetadata" />
         </WrapPanel>
         <TextBlock Text="Evaluation results and actual tokens are shown in Local AI. The model catalog and permissions are stored under AI &amp; Models." TextWrapping="Wrap" Margin="0,8,0,12" />
         <Button Content="Ollama model catalog" Click="OpenSectionSettings" Tag="AI" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Tools" MinWidth="170" x:Name="SettingsToolsSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <ContentControl x:Name="ToolsSettingsHost" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Workflows" MinWidth="170" x:Name="SettingsWorkflowsSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <TextBlock Text="Orchestration is integrated into Tasks" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,8" />
         <TextBlock Text="Plans, dependencies and approvals are managed in Tasks/Workflows. Default time, budget and Away live in Settings → Tasks; tool connections and permissions live in Settings → Tools." TextWrapping="Wrap" />
         <TextBlock Text="A workflow is a plan for one piece of work, not a global setting. Each connector's connection, timeout and write/AI-call/publish permissions are configured centrally in Tools." TextWrapping="Wrap" Margin="0,8,0,12" />
         <Button Content="Configure connectors &amp; permissions" Click="OpenSectionSettings" Tag="Tools" />
         <Button Content="Open workflow plans" Click="OpenWorkflowWorkspace" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>

      <TabItem Header="Notifications" MinWidth="170" x:Name="SettingsNotificationsSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <CheckBox x:Name="WindowsNotifications" Content="Show Windows notifications when tasks need attention" Click="ToggleWindowsNotifications" />
         <TextBlock Text="Telegram" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,4" />
         <TextBlock Text="Send a message to your Telegram chat when a task stops. Create a bot with @BotFather, then enter its token and your chat ID." TextWrapping="Wrap" Margin="0,0,0,8" />
         <CheckBox x:Name="TelegramEnabled" Content="Enable Telegram notifications" Margin="0,0,0,8" />
         <TextBlock Text="Bot token" Margin="0,4,0,2" />
         <PasswordBox x:Name="TelegramToken" MaxWidth="520" HorizontalAlignment="Left" />
         <TextBlock x:Name="TelegramTokenHint" Margin="0,2,0,0" Opacity="0.75" TextWrapping="Wrap" />
         <TextBlock Text="Allowed chat ID" Margin="0,8,0,2" />
         <StackPanel Orientation="Horizontal">
          <TextBox x:Name="TelegramChatId" Width="260" HorizontalAlignment="Left" />
          <Button x:Name="TelegramFindChatButton" Content="Find chat ID" Click="FindTelegramChatId" Margin="8,0,0,0" ToolTip="Send /start to your bot first, then click. Fills the box from the latest message." />
         </StackPanel>
         <CheckBox x:Name="TelegramNotifyCompleted" Content="Notify on completed tasks" Margin="0,8,0,8" />
         <StackPanel Orientation="Horizontal">
          <Button Content="Save Telegram settings" Click="SaveTelegramSettings" Margin="0,0,8,0" />
          <Button x:Name="TelegramTestButton" Content="Send test message" Click="TestTelegram" />
         </StackPanel>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Updates" MinWidth="170" x:Name="SettingsUpdatesSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <TextBlock Text="Updates use an existing local build: review the manifest/hash, back up and verify the manager starts. Nothing is built or downloaded automatically. Paths of apps to update are in the connector settings under Tools." TextWrapping="Wrap" Margin="0,8,0,12" />
         <Button Content="Open update actions" Click="OpenUpdateWorkspace" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>
     </TabControl>
    </DockPanel>
   </TabItem>
   <TabItem Header="Activity &amp; history" x:Name="ActivityTab">
    <Grid Margin="24">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
     </Grid.RowDefinitions>
     <WrapPanel>
      <Button Content="Refresh selected task history" Click="RefreshHistory" />
      <Button Content="View local evaluation results" Click="ShowEvaluations" />
      <DatePicker x:Name="ReportDate" Width="140" />
      <Button Content="Daily report" Click="ShowDailyReport" />
      <Button Content="Export report" Click="ExportDailyReport" />
     </WrapPanel>
     <TextBox Grid.Row="1" x:Name="HistoryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
    </Grid>
   </TabItem>
   <TabItem Header="Dashboard" x:Name="DashboardTab">
    <ContentControl x:Name="DashboardHost" />
   </TabItem>
   <TabItem Header="Agents" x:Name="AgentsTab">
    <DockPanel Margin="22">
     <WrapPanel DockPanel.Dock="Top">
      <TextBlock Text="Running agents" FontSize="24" FontWeight="SemiBold" Margin="0,0,18,18" />
      <Button Content="Open task" Click="OpenSelectedAgent" />
      <Button Content="Stop selected task" Click="StopSelectedAgent" />
      <Button Content="Configure agents" Click="OpenSectionSettings" Tag="Agents" />
     </WrapPanel>
     <DataGrid x:Name="AgentsGrid" AutoGenerateColumns="True" />
    </DockPanel>
   </TabItem>
   <TabItem Header="Local AI" x:Name="LocalTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="22">
      <TextBlock Text="Local AI · Ollama" FontSize="25" FontWeight="SemiBold" />
      <Button Content="Configure &amp; evaluate Local AI" Click="OpenSectionSettings" Tag="Local" />
      <TextBlock x:Name="LocalResources" TextWrapping="Wrap" Margin="0,12,0,12" />
      <DataGrid x:Name="LocalResults" Height="170" AutoGenerateColumns="True" />
      <TextBlock Text="Advanced evaluation (grants no code-editing permission)" FontSize="18" Margin="0,16,0,10" />
      <DataGrid x:Name="AdvancedLocalResults" Height="170" AutoGenerateColumns="True" />
      <TextBlock Text="Tokens reported by provider · not balance/quota" FontSize="18" Margin="0,16,0,10" />
      <DataGrid x:Name="ReportedUsageGrid" Height="150" AutoGenerateColumns="True" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Tools &amp; Workflows" x:Name="ToolsTab">
    <ContentControl x:Name="ToolsHost" />
   </TabItem>
   <TabItem Header="Approvals" x:Name="ApprovalsTab">
    <DockPanel Margin="22">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Waiting for your decision" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,15" />
      <WrapPanel>
       <Button Content="Open selected task" Click="OpenSelectedApproval" />
       <Button Content="Review tools / workflows" Click="OpenToolApprovals" />
       <TextBlock x:Name="ToolApprovalCount" VerticalAlignment="Center" />
      </WrapPanel>
     </StackPanel>
     <DataGrid x:Name="ApprovalsGrid" AutoGenerateColumns="True" />
    </DockPanel>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="Status" Text="Ready · register a project to begin. AI providers are disabled until you enable them." Margin="12,3,12,3" TextWrapping="Wrap" Foreground="#B8B0CF" FontSize="10" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,12,0" Grid.Column="1" Panel.ZIndex="20">
   <Button Content="─" Click="MinimizeShell" Padding="0" Width="42" Height="30" MinHeight="30" Margin="0" Background="Transparent" BorderThickness="0" />
   <Button Content="□" Click="MaximizeShell" Padding="0" Width="42" Height="30" MinHeight="30" Margin="0" Background="Transparent" BorderThickness="0" />
   <Button Content="×" Click="CloseShell" Padding="0" Width="42" Height="30" MinHeight="30" Margin="0" Background="Transparent" BorderThickness="0" />
  </StackPanel>
 </Grid>
</Window>




