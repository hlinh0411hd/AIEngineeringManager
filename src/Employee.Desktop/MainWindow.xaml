           <DataGridTemplateColumn Header="Use" Width="55">
            <DataGridTemplateColumn.CellTemplate>
             <DataTemplate>
              <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="AgentEnabledClicked" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Tick to let tasks use this agent" />
             </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
           </DataGridTemplateColumn>
           <DataGridTextColumn Header="Agent" Binding="{Binding Name}" Width="*" />
           <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180" />
           <DataGridTextColumn Header="Models" Binding="{Binding Models}" Width="105" />
           <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="115" />
           <DataGridTextColumn Header="Runs today" Binding="{Binding Runs}" Width="90" />
           <DataGridTextColumn Header="Auth" Binding="{Binding Auth}" Width="100" />
           <DataGridTemplateColumn Header="" Width="120">
            <DataGridTemplateColumn.CellTemplate>
             <DataTemplate>
              <Button Content="Details…" Click="AgentDetailsClicked" Padding="8,2" Margin="4,0" MinHeight="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
