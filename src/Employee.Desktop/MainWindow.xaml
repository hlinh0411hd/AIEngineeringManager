          <RadioButton x:Name="NoCliChoice" Content="Do not use external AI providers" GroupName="CliMode" Margin="0,4" />
         </WrapPanel>
         <WrapPanel Margin="0,10,0,4">
          <Button Content="Detect agents &amp; models" Click="DetectProviders" Background="#7545D6" Foreground="White" />
          <Button Content="Enable usable agents" Click="EnableAvailableProviders" />
          <Button x:Name="UpdateWebRatingsButton" Content="Update model ratings from web" Click="UpdateRatingsFromWeb" ToolTip="Consult public benchmark and pricing websites to update quality and usage rank for all agent models" />
          <TextBlock Text="Detection asks the CLI Tool API only; no inference is run." Foreground="#B8B0CF" VerticalAlignment="Center" Margin="8,0,0,8" />
         </WrapPanel>
<TextBlock x:Name="CliToolApiStatus" TextWrapping="Wrap" Foreground="#B8B0CF" Margin="0,2,0,8" />
          <TextBlock x:Name="WebRatingsBanner" TextWrapping="Wrap" Foreground="#B8B0CF" Margin="0,0,0,8" />
          <DataGrid x:Name="ProviderAgentsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" PreviewMouseLeftButtonUp="ProviderAgentRowClicked" Height="330" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
