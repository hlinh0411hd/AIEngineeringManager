<Window xmlns:local="clr-namespace:Employee.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Employee.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Title="AI Employee Manager" Icon="Assets/app.ico" WindowStyle="None" WindowState="Maximized" Width="1672" Height="940" MinWidth="1320" MinHeight="820" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14" />
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <local:TaskModifiedTimeConverter x:Key="TaskModifiedTime" />
  <local:TaskProjectNameConverter x:Key="TaskProjectName" />
  <local:StepNumberConverter x:Key="StepNumber" />
  <local:StepTimeConverter x:Key="StepTime" />
  <local:MilestoneInfoConverter x:Key="MilestoneInfo" />
  <Style x:Key="TaskSelectionCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal" Background="Transparent">
       <Border x:Name="SelectionBox" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#B8B0CF" Background="#211C34" VerticalAlignment="Center">
        <Grid>
         <Path x:Name="Tick" Data="M3,8 L7,12 14,4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
         <Path x:Name="Partial" Data="M4,8 H12" Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
        </Grid>
       </Border>
       <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
        <Setter TargetName="SelectionBox" Property="Background" Value="#7950C7" />
       </Trigger>
       <Trigger Property="IsChecked" Value="{x:Null}">
        <Setter TargetName="Partial" Property="Visibility" Value="Visible" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="White" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#17142D" Offset="0" />
    <GradientStop Color="#0D0E1D" Offset="1" />
   </LinearGradientBrush>
  </Grid.Background>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="262" />
   <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Padding="18,12" BorderBrush="#312B4A" BorderThickness="0,0,1,1" MouseLeftButtonDown="DragShell" Panel.ZIndex="3">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#252037" Offset="0" />
     <GradientStop Color="#181729" Offset="1" />
    </LinearGradientBrush>
   </Border.Background>
   <DockPanel>
    <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0">
     <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#995AFA" Offset="0" />
       <GradientStop Color="#6C63C9" Offset="1" />
      </LinearGradientBrush>
     </Border.Background>
     <Viewbox Width="26" Height="26" VerticalAlignment="Center">
      <Canvas Width="24" Height="24">
       <Path Data="M12,2 L15,9 22,12 15,15 12,22 9,15 2,12 9,9 Z M4,1 V6 M1,4 H6 M21,18 V23 M18,21 H23" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Canvas>
     </Viewbox>
    </Border>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="AI Employee" FontSize="17" FontWeight="Bold" />
     <TextBlock Text="Minimalist Workspace" Foreground="#B4A9CC" FontSize="11" Margin="0,2,0,0" />
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Column="1" Grid.Row="0" BorderBrush="#312B4A" BorderThickness="0,0,0,1" Padding="18,10,140,10" Background="Transparent" MouseLeftButtonDown="DragShell">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="NotificationButton" Content="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Click="ShowNotifications" ToolTip="Notifications" Width="38" Height="38" MinHeight="38" Padding="0" Margin="0,0,8,0" />
    <Border Background="#0E3328" BorderBrush="#1E684A" BorderThickness="1" CornerRadius="16" Padding="12,7" Margin="0,0,8,0" MinWidth="104" VerticalAlignment="Center">
     <TextBlock x:Name="HeaderRunState" Text="● Ready" Foreground="#7EE7B8" TextAlignment="Center" FontSize="12" />
    </Border>
    <TextBlock x:Name="HeaderElapsed" Text="—" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="52" TextAlignment="Center" Foreground="#B8B0CF" FontSize="12" />
    <Button Click="ShellNewTask" Height="38" MinHeight="38" Margin="0" Padding="14,6">
     <Button.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#8650DB" Offset="0" />
       <GradientStop Color="#6334B7" Offset="1" />
      </LinearGradientBrush>
     </Button.Background>
     <StackPanel Orientation="Horizontal">
      <Viewbox Width="16" Height="16" VerticalAlignment="Center">
       <Canvas Width="24" Height="24">
        <Path Data="M12,4 V20 M4,12 H20" Stroke="#DDD1FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
       </Canvas>
      </Viewbox>
      <TextBlock Text="New Task" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
     </StackPanel>
    </Button>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" BorderBrush="#312B4A" BorderThickness="0,0,1,0">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#201C32" Offset="0" />
     <GradientStop Color="#161525" Offset="1" />
    </LinearGradientBrush>
   </Border.Background>
   <DockPanel Margin="12,14">
    <StackPanel DockPanel.Dock="Bottom" Margin="8,16,8,12">
     <Border Height="1" Background="#383047" Margin="0,0,0,18" />
     <DockPanel>
      <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,13,0">
       <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
         <GradientStop Color="#9C8CF5" Offset="0" />
         <GradientStop Color="#6569CD" Offset="1" />
        </LinearGradientBrush>
       </Border.Background>
       <TextBlock Text="AI" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="My Workspace" FontWeight="SemiBold" FontSize="14" />
       <TextBlock Text="AI Employee Manager · V5" Foreground="#ADA3C1" FontSize="10" Margin="0,5,0,0" />
      </StackPanel>
     </DockPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="ShellNavigation">
      <Button Style="{StaticResource ShellMenuButton}" Content="◈   Rik's office" Tag="office" Click="ShellNavigate" />
      <Button Style="{StaticResource ShellMenuButton}" Content="⌂   Dashboard" Tag="dashboard" Click="ShellNavigate" />
      <Button Style="{StaticResource ShellMenuButton}" Content="☷   Tasks" Tag="tasks" Click="ShellNavigate" />
      <Button Style="{StaticResource ShellMenuButton}" Content="✓   Approvals" Tag="approvals" Click="ShellNavigate" />
      <Button Style="{StaticResource ShellMenuButton}" Content="▱   Projects" Tag="projects" Click="ShellNavigate" />
      <Button Style="{StaticResource ShellMenuButton}" Content="▣   Providers &amp; Models" Tag="providers" Click="ShellNavigate" />
      <Button Style="{StaticResource ShellMenuButton}" Content="▦   Tools" Tag="tools" Click="ShellNavigate" />
      <Border Height="1" Background="#3B344F" Margin="8,14,8,14" />
      <Button Style="{StaticResource ShellMenuButton}" Content="⚙   Settings" Tag="settings" Click="ShellNavigate" />
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <TabControl Grid.Row="1" Grid.Column="1" Style="{StaticResource ContentTabs}" x:Name="Tabs">
   <TabItem Header="Rik's office" x:Name="OfficeTab">
    <local:VirtualOfficeView x:Name="OfficeView" />
   </TabItem>
   <TabItem Header="Projects" x:Name="ProjectsTab">
    <Grid Margin="24">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="140" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20">
      <TextBlock Text="Your projects" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Connect a project folder, then keep its files indexed and ready for your AI team." Foreground="#B8B0CF" Margin="0,6,0,0" TextWrapping="Wrap" />
     </StackPanel>
     <DataGrid Grid.Row="2" x:Name="ProjectGrid" SelectionChanged="ProjectSelected">
      <DataGrid.RowStyle>
       <Style TargetType="DataGridRow">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Create task for this project" />
        <EventSetter Event="MouseLeftButtonUp" Handler="ProjectTaskClicked" />
        <EventSetter Event="KeyDown" Handler="ProjectTaskKeyDown" />
       </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="180" />
       <DataGridTextColumn Header="Technology" Binding="{Binding Technology}" Width="150" />
       <DataGridTextColumn Header="Keywords" Binding="{Binding Keywords}" Width="220" />
       <DataGridTextColumn Header="Folder" Binding="{Binding Root}" Width="*" />
      </DataGrid.Columns>
     </DataGrid>
     <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button Content="Search indexed paths" Click="SearchIndex" DockPanel.Dock="Right" />
      <TextBox x:Name="SearchQuery" ToolTip="File path metadata only. No source file content sent to AI." />
     </DockPanel>
     <ListBox Grid.Row="4" x:Name="SearchResults" BorderBrush="#E1E7EF" />
     <WrapPanel Grid.Row="1">
      <Button Content="Configure projects / add project" Click="OpenSectionSettings" Tag="Projects" />
      <Button Content="Update index" Click="IndexProject" />
      <Button Content="Scan keywords" Click="ScanProjectKeywords" />
     </WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Tasks" x:Name="TasksTab">
    <Grid Margin="16">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
     </Grid.RowDefinitions>
     <Grid Grid.Row="1" x:Name="TaskLayout">
      <TabControl x:Name="TaskCreateView" Grid.Row="0" Visibility="Collapsed">
       <TabItem Header="AI task" x:Name="CreateAiTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <Grid Margin="12">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TaskManualFields" Visibility="Collapsed">
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>
         <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Project" />
          <ComboBox x:Name="TaskProject" DisplayMemberPath="Name" />
         </StackPanel>
         <StackPanel x:Name="TaskKindField" Grid.Column="1">
          <TextBlock Text="Task type" />
          <ComboBox x:Name="TaskKind" IsEnabled="False" />
         </StackPanel>
         <StackPanel x:Name="TaskAccessField" Grid.Row="1">
          <TextBlock Text="Project access" />
          <ComboBox x:Name="TaskAccess" IsEnabled="False" />
         </StackPanel>
         <StackPanel x:Name="TaskPriorityField" Grid.Row="1" Grid.Column="1">
          <TextBlock Text="Priority (0-100, higher runs first)" />
          <TextBox x:Name="TaskPriority" Text="50" />
         </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" x:Name="TaskInputPanel">
         <WrapPanel x:Name="TaskRoutePanel" Visibility="Collapsed">
          <StackPanel>
           <TextBlock Text="AI provider" />
           <ComboBox x:Name="CreateProviderChoice" Width="180" DisplayMemberPath="Label" SelectionChanged="TaskProviderChanged" />
          </StackPanel>
          <StackPanel>
           <TextBlock Text="Model" />
           <ComboBox x:Name="CreateModelChoice" Width="300" DisplayMemberPath="Label" />
          </StackPanel>
         </WrapPanel>
         <WrapPanel>
          <CheckBox x:Name="ScheduleEnabled" Content="Schedule (app must remain open)" />
          <DatePicker x:Name="ScheduleDate" Width="145" />
          <TextBox x:Name="ScheduleTime" Width="80" ToolTip="HH:mm, computer local time" />
         </WrapPanel>
         <TextBlock x:Name="TaskRouteHint" Visibility="Collapsed" Text="Choose a permitted model in AI providers to add more options." TextWrapping="Wrap" Foreground="#B8B0CF" />
         <StackPanel x:Name="TaskWorkflowPanel" Visibility="Collapsed">
          <TextBlock Text="Tool workflow (optional; runs from this task without an AI planning call)" />
          <ComboBox x:Name="TaskWorkflowChoice" DisplayMemberPath="Name" />
         </StackPanel>
         <CheckBox x:Name="TestAfterBuildEnabled" Content="Test after build" Margin="0,8,0,0" ToolTip="Run the project's tests once the task's steps and its build check have finished." />
         <TextBox x:Name="TaskRequest" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="Enter a request, then click Assign &amp; run to start orchestration" />
        </StackPanel>
        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
         <Button Content="Assign &amp; run" Click="SubmitTask" Background="#7545D6" Foreground="White" />
         <Button x:Name="QueueNewTaskButton" Content="Add to queue" Click="QueueNewTask" ToolTip="Create a task and run it automatically when the current operation finishes." />
         <Button Content="Save for later" Click="CreateTask" />
        </WrapPanel>
       </Grid>
      </ScrollViewer>
       </TabItem>
       <TabItem Header="Tool task" x:Name="CreateToolTab">
        <ContentControl x:Name="ToolTaskHost" />
       </TabItem>
      </TabControl>
      <Grid x:Name="TaskListView">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <TextBlock Text="Task list" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
       <DockPanel Grid.Row="1">
        <StackPanel DockPanel.Dock="Top">
         <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
          <Button x:Name="PreviousTaskPageButton" Content="" FontFamily="Segoe MDL2 Assets" Width="34" MinHeight="34" Padding="0" Click="PreviousTaskPage" ToolTip="Previous page" AutomationProperties.Name="Previous page" />
          <TextBlock x:Name="TaskPageStatus" VerticalAlignment="Center" Margin="2,0,8,8" />
          <Button x:Name="NextTaskPageButton" Content="" FontFamily="Segoe MDL2 Assets" Width="34" MinHeight="34" Padding="0" Click="NextTaskPage" ToolTip="Next page" AutomationProperties.Name="Next page" />
          <Border Width="1" Height="22" Background="#3B344F" Margin="4,0,10,8" />
          <ToggleButton x:Name="TaskFilterButton" Content="Filter" Padding="12,7" Margin="0,0,8,8" VerticalAlignment="Top" />
          <Popup x:Name="TaskFilterPopup" PlacementTarget="{Binding ElementName=TaskFilterButton}" Placement="Bottom" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=TaskFilterButton, Mode=TwoWay}" Opened="TaskFilterOpened">
           <Border Background="#211D32" BorderBrush="#49415F" BorderThickness="1" CornerRadius="8" Padding="12" PreviewKeyDown="TaskFilterKeyDown">
            <StackPanel>
             <WrapPanel>
              <Button Content="Select all" Click="SelectAllTaskStates" />
              <Button Content="Clear" Click="ClearTaskStates" />
             </WrapPanel>
             <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="TaskStateFilter" AutomationProperties.Name="Filter tasks by state" />
             </ScrollViewer>
            </StackPanel>
           </Border>
          </Popup>
          <WrapPanel x:Name="TaskStateLabels" />
          <ComboBox x:Name="TaskProjectFilter" DisplayMemberPath="Name" MinWidth="180" MaxWidth="280" Margin="0,0,8,8" SelectionChanged="TaskProjectFilterChanged" AutomationProperties.Name="Filter tasks by project" ToolTip="Filter by project" />
          <TextBlock x:Name="TaskFilterCount" VerticalAlignment="Center" Margin="4,0,0,8" Foreground="#B8B0CF" />
         </WrapPanel>
         <WrapPanel Margin="0,0,0,8">
          <CheckBox x:Name="SelectVisibleTasks" Style="{StaticResource TaskSelectionCheck}" Content="Select all visible tasks" Click="SelectVisibleTasksClicked" VerticalAlignment="Center" Margin="0,0,16,0" />
          <TextBlock x:Name="SelectedTaskCount" Text="0 selected" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button x:Name="DeleteSelectedTasksButton" Content="Delete selected" Click="DeleteSelectedTasks" IsEnabled="False" />
          <Button Content="Resume selected task" Click="ResumeSelectedTask" ToolTip="Continue the selected paused task from its saved progress">
           <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
             <Setter Property="Visibility" Value="Collapsed" />
             <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedItem.State, ElementName=TaskGrid}" Value="Paused">
               <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Button.Style>
          </Button>
          <Button x:Name="CompleteSelectedTasksButton" Content="Complete selected" Click="CompleteSelectedTasks" IsEnabled="False" ToolTip="Mark the selected tasks reviewed and complete; unfinished steps are closed after you confirm" />
          <Button x:Name="CloseSelectedTasksButton" Content="Close selected as ▾" Click="OpenCloseTaskMenu" IsEnabled="False" ToolTip="End the selected tasks without completing them">
           <Button.ContextMenu>
            <ContextMenu>
             <MenuItem Header="Not completed" Tag="Incomplete" Click="CloseSelectedTasksAs" />
             <MenuItem Header="Does not meet requirements" Tag="NotMet" Click="CloseSelectedTasksAs" />
             <MenuItem Header="Cancel tasks" Tag="Cancelled" Click="CloseSelectedTasksAs" />
            </ContextMenu>
           </Button.ContextMenu>
          </Button>
         </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="TaskGrid" CanUserSortColumns="True" Sorting="TaskGridSorting" SelectionChanged="WorkSelected" RowHeight="38" MouseLeftButtonUp="OpenTaskDetails">
         <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
           <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="WrongAccess">
             <Setter Property="Foreground" Value="#FFB899" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="WrongProject">
             <Setter Property="Foreground" Value="#B8C5FF" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </DataGrid.RowStyle>
         <DataGrid.GroupStyle>
          <!-- One collapsible group per project; collapsed projects stay collapsed across refreshes. -->
          <GroupStyle>
           <GroupStyle.ContainerStyle>
            <Style TargetType="GroupItem">
             <Setter Property="Template">
              <Setter.Value>
               <ControlTemplate TargetType="GroupItem">
                <Expander Loaded="TaskGroupLoaded" Expanded="TaskGroupToggled" Collapsed="TaskGroupToggled" IsExpanded="True" Margin="0,4,0,2" Foreground="#E6E1F5"
                          AutomationProperties.Name="{Binding Name, StringFormat=Project {0}}">
                 <Expander.Header>
                  <StackPanel Orientation="Horizontal" Margin="2,6,0,4">
                   <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                   <TextBlock Text="{Binding ItemCount, StringFormat=  ·  {0}}" Foreground="#B8B0CF" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                 </Expander.Header>
                 <ItemsPresenter />
                </Expander>
               </ControlTemplate>
              </Setter.Value>
             </Setter>
            </Style>
           </GroupStyle.ContainerStyle>
          </GroupStyle>
         </DataGrid.GroupStyle>
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="Select" Width="65" CanUserSort="False">
           <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
             <CheckBox Style="{StaticResource TaskSelectionCheck}" Loaded="TaskDeleteCheckLoaded" DataContextChanged="TaskDeleteCheckContextChanged" Click="TaskDeleteCheckClicked" AutomationProperties.Name="Select task" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Width="18" Height="18" IsThreeState="False" />
            </DataTemplate>
           </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Request" SortMemberPath="Name" Binding="{Binding RequestPreview}" Width="*" MinWidth="260">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="TextWrapping" Value="NoWrap" />
             <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Project" SortMemberPath="Project" Binding="{Binding ProjectId,Converter={StaticResource TaskProjectName}}" Width="180" />
          <DataGridTextColumn Header="State" SortMemberPath="State" Binding="{Binding State}" Width="150" />
          <DataGridTextColumn Header="Time modified" SortMemberPath="UpdatedAt" Binding="{Binding Converter={StaticResource TaskModifiedTime}}" Width="160" />
          <DataGridTextColumn Header="AI" CanUserSort="False" Binding="{Binding ProviderId}" Width="70" />
          <DataGridTextColumn Header="Model" CanUserSort="False" Binding="{Binding ModelDisplay}" Width="150" />
          <DataGridTextColumn Visibility="Collapsed" Header="Runs" CanUserSort="False" Binding="{Binding Attempts}" Width="55" />
          <DataGridTextColumn Visibility="Collapsed" Header="Scheduled" CanUserSort="False" Binding="{Binding ScheduledAt,StringFormat=dd/MM HH:mm}" Width="115" />
          <DataGridTextColumn Header="Problem" CanUserSort="False" Binding="{Binding ProblemReason}" Width="270">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="ToolTip" Value="{Binding ProblemReason}" />
             <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
         </DataGrid.Columns>
        </DataGrid>
       </DockPanel>
      </Grid>
      <Grid x:Name="TaskDetailsView" Visibility="Collapsed">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <Border Grid.Row="0" Background="#1D1A2E" BorderBrush="#3F3859" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,10">
        <StackPanel>
        <WrapPanel VerticalAlignment="Center">
         <Button Content="" FontFamily="Segoe MDL2 Assets" Width="38" Padding="0" ToolTip="Back to task list" AutomationProperties.Name="Back to task list" Click="ShowTaskList" />
         <Button Click="StartWork" Background="#7545D6" Foreground="White" ToolTip="Run or resume this task">
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
           <TextBlock Text="Run / resume" />
          </StackPanel>
         </Button>
         <Button Content="Rerun" Click="RerunTask" ToolTip="Start a fresh run with your request and updates. Keeps the old run; does not undo project files." AutomationProperties.Name="Rerun task from the beginning" />
         <Button Content="Approve" Click="ApproveWork" ToolTip="Approve and continue" />
         <Button Content="" FontFamily="Segoe MDL2 Assets" Width="38" Padding="0" Click="StopWork" ToolTip="Stop and save" AutomationProperties.Name="Stop and save" />
         <Button x:Name="QueueSelectedTaskButton" Content="" FontFamily="Segoe MDL2 Assets" Width="38" Padding="0" Click="QueueSelectedTask" Visibility="Collapsed" ToolTip="Add to execution queue" AutomationProperties.Name="Add to execution queue" />
         <Border Width="1" Height="24" Background="#49415F" Margin="4,0,12,8" />
         <Button Content="" FontFamily="Segoe MDL2 Assets" Width="38" Padding="0" Click="ViewResult" ToolTip="View result and changed files" AutomationProperties.Name="View result and changed files" />
         <Button Content="" FontFamily="Segoe MDL2 Assets" Width="38" Padding="0" Click="ViewTaskDiagram" ToolTip="View orchestration diagram" AutomationProperties.Name="View orchestration diagram" />
         <Button Click="CompleteWork" ToolTip="Mark the reviewed result complete. If some steps are unfinished but the result is good, you can complete it anyway" Foreground="#64E3B4">
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
           <TextBlock Text="Complete" />
          </StackPanel>
         </Button>
         <Button x:Name="CloseTaskButton" Content="Close as ▾" Click="OpenCloseTaskMenu" ToolTip="End the task without completing it: not completed, does not meet the requirements, or cancelled">
          <Button.ContextMenu>
           <ContextMenu>
            <MenuItem Header="Not completed" Tag="Incomplete" Click="CloseTaskAs" ToolTip="The work stopped before the task was done" />
            <MenuItem Header="Does not meet requirements" Tag="NotMet" Click="CloseTaskAs" ToolTip="The result is not what was asked; counts as a miss for the AIs that made it" />
            <MenuItem Header="Cancel task" Tag="Cancelled" Click="CloseTaskAs" ToolTip="The task is no longer wanted" />
           </ContextMenu>
          </Button.ContextMenu>
         </Button>
        </WrapPanel>
        <!-- What the user should do now, in plain words with the button to press. -->
        <Border x:Name="NextStepBanner" Background="#2A2140" BorderBrush="#7545D6" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,8,0,0" Visibility="Collapsed">
         <DockPanel>
          <TextBlock Text="What to do next" FontWeight="SemiBold" Foreground="#BE9BFF" DockPanel.Dock="Top" Margin="0,0,0,3" />
          <TextBlock x:Name="NextStepText" TextWrapping="Wrap" Foreground="#EEEAFB" />
         </DockPanel>
        </Border>
        </StackPanel>
       </Border>
       <TabControl Grid.Row="2" x:Name="TaskPanels">
        <TabItem Header="Project">
         <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Task project" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Project tasks receive write access automatically. Changing project starts a fresh execution and keeps the previous history." TextWrapping="Wrap" Foreground="#B8B0CF" Margin="0,8,0,16" />
          <TextBlock Text="Project" />
          <ComboBox x:Name="DetailProjectChoice" DisplayMemberPath="Name" MinWidth="360" />
          <TextBlock x:Name="DetailProjectPath" TextWrapping="Wrap" Margin="0,6,0,12" />
          <TextBlock x:Name="DetailAccessStatus" TextWrapping="Wrap" Margin="0,8" />
          <Button Content="Save project" Click="SaveTaskProjectAccess" HorizontalAlignment="Left" />
         </StackPanel>
        </TabItem>
        <TabItem Header="Results">
         <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="10,4,0,0">
           <TextBlock Text="New duration (minutes, 0 = unlimited)" VerticalAlignment="Center" Margin="0,0,8,8" />
           <TextBox x:Name="RenewMinutes" Text="480" Width="80" />
           <Button Content="Extend &amp; continue" Click="RenewTaskTime" />
           <TextBlock Text="AI call limit (0 = unlimited)" VerticalAlignment="Center" Margin="8,0,8,8" />
           <TextBox x:Name="TaskCallLimit" Width="80" />
           <Button x:Name="SaveTaskCallLimitButton" Content="Save AI limit" Click="SaveTaskCallLimit" />
           <TextBlock x:Name="TaskCallStatus" VerticalAlignment="Center" Margin="0,0,8,8" />
           <TextBlock x:Name="TaskTimeStatus" VerticalAlignment="Center" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBox x:Name="TaskDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="10" />
         </DockPanel>
        </TabItem>
        <TabItem Header="Steps &amp; approvals">
         <Grid Margin="10">
          <Grid.RowDefinitions>
           <RowDefinition Height="2*" />
           <RowDefinition Height="*" />
           <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DataGrid x:Name="StepsGrid" CanUserSortColumns="True">
           <DataGrid.GroupStyle>
            <!-- Tasks with milestones: one collapsible group per milestone, in milestone order. -->
            <GroupStyle>
             <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
               <Setter Property="Template">
                <Setter.Value>
                 <ControlTemplate TargetType="GroupItem">
                  <Expander IsExpanded="True" Margin="0,4,0,2" Foreground="#E6E1F5" AutomationProperties.Name="{Binding Name}">
                   <Expander.Header>
                    <StackPanel Margin="2,6,0,4">
                     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                     <TextBlock Text="{Binding Name, Converter={StaticResource MilestoneInfo}}" Foreground="#B8B0CF" FontSize="12" TextWrapping="Wrap" MaxWidth="900" Margin="0,2,0,0" />
                    </StackPanel>
                   </Expander.Header>
                   <ItemsPresenter />
                  </Expander>
                 </ControlTemplate>
                </Setter.Value>
               </Setter>
              </Style>
             </GroupStyle.ContainerStyle>
            </GroupStyle>
           </DataGrid.GroupStyle>
           <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
             <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="WrongAccess">
               <Setter Property="Foreground" Value="#FFB899" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="WrongProject">
               <Setter Property="Foreground" Value="#B8C5FF" />
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </DataGrid.RowStyle>
           <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Id, Converter={StaticResource StepNumber}}" SortMemberPath="CreatedAt" Width="46" />
            <DataGridTextColumn Header="Task step" Binding="{Binding Request}" Width="*" />
            <DataGridTextColumn Header="Difficulty" Binding="{Binding DifficultyDisplay}" Width="150">
             <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
               <Setter Property="ToolTip" Value="{Binding CapabilityDisplay,StringFormat='Work type: {0}. Score 0-100; the least-usage model meeting this level is chosen.'}" />
              </Style>
             </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Work type" Binding="{Binding CapabilityDisplay}" Width="150">
             <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
               <Setter Property="ToolTip" Value="{Binding CapabilityDisplay}" />
               <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
             </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Executed by" Binding="{Binding ExecutorDisplay}" Width="220" />
            <DataGridTextColumn Header="Skill" Binding="{Binding SkillId}" Width="180" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="150" />
            <DataGridTextColumn Header="When it ran" Binding="{Binding Id, Converter={StaticResource StepTime}}" Width="230">
             <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
               <Setter Property="ToolTip" Value="The first attempt's start and the last attempt's end, local time. Steps are in the order they ran." />
              </Style>
             </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="AI" Binding="{Binding ProviderId}" Width="90" />
            <DataGridTextColumn Header="Model" Binding="{Binding ModelDisplay}" Width="150">
             <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
               <Setter Property="ToolTip" Value="{Binding ModelDisplay}" />
               <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
             </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Tests" Binding="{Binding Verification}" Width="120" />
            <DataGridTextColumn Header="Problem" Binding="{Binding ProblemReason}" Width="270">
             <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
               <Setter Property="ToolTip" Value="{Binding ProblemReason}" />
               <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
             </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
           </DataGrid.Columns>
          </DataGrid>
          <DataGrid Grid.Row="1" x:Name="PendingGrid" SelectionChanged="PendingDecisionChanged" Margin="0,8,0,8">
           <DataGrid.Columns>
            <DataGridTextColumn Header="Recorded reason (select for details)" Binding="{Binding Message}" Width="*" />
            <DataGridTextColumn Header="Action type" Binding="{Binding Kind}" Width="130" />
           </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2">
          <TextBox x:Name="PendingDecisionDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="155" VerticalScrollBarVisibility="Auto" />
          <WrapPanel>
           <!-- The few everyday actions; the rest are in More. Approve/Reject and Apply edits show only when there is something to act on. -->
           <Button x:Name="ApproveSelectedDecisionButton" Content="✔ Approve" IsEnabled="False" Click="ApproveWork" ToolTip="Accept the selected decision below (a plan, a result to review, a tool request) and continue." />
           <Button x:Name="RejectDecisionButton" Content="✖ Reject" Click="RejectPending" ToolTip="Refuse the selected decision below; the task waits for a new comment or plan." />
           <Button x:Name="ApplyEditsButton" Content="Apply edits" Click="ApplyEdits" Visibility="Collapsed" ToolTip="This step's AI proposed file changes instead of editing directly. Review them, then write them into the project." />
           <Button Content="Skip step" Click="SkipSelectedStep" ToolTip="Skip the selected stopped step without approving its result or tests. Then resume or send a new comment." />
           <Button x:Name="TaskMoreButton" Content="More ▾" Click="OpenTaskMore" ToolTip="Less common actions">
            <Button.ContextMenu>
             <ContextMenu>
              <MenuItem Header="View step result" Click="ViewStep" ToolTip="Show what the selected step did (its output, files and notes)." />
              <MenuItem Header="Change AI for this step" Click="ChangeSelectedStepAI" ToolTip="Run the selected step again with another AI or model." />
              <MenuItem Header="Choose the AI for the whole task…" Click="ShowTaskAiChoice" ToolTip="Pick a provider/model (or the planner) and run the task with it instead of automatic selection." />
              <Separator />
              <MenuItem Header="Rate: good result" Click="RateGood" ToolTip="Tell the router this AI did well on this kind of work; it is picked more often." />
              <MenuItem Header="Rate: needs improvement" Click="RatePoor" ToolTip="Tell the router this AI did poorly on this kind of work; a stronger one is picked next time." />
              <MenuItem Header="Remember this result" Click="RememberReviewedTask" ToolTip="Save the reviewed result as a project note the AIs see in later tasks." />
              <MenuItem Header="Correct the task type" Click="TeachTaskIntent" ToolTip="The task was classified wrongly (e.g. coding vs content): fix it and teach the classifier." />
              <Separator />
              <MenuItem Header="Tool requests and files" Click="OpenTaskTools" ToolTip="Open the Tools page: requests sent to tools and the files they produced." />
              <Separator />
              <MenuItem x:Name="TaskAwayMenu" Header="Keep working while I'm away" IsCheckable="True" Click="ToggleTaskAway" ToolTip="Steps that do not need your decision keep running on their own." />
             </ContextMenu>
            </Button.ContextMenu>
           </Button>
           <CheckBox x:Name="TaskAway" Content="Keep working while I'm away" Checked="TaskAwayChanged" Unchecked="TaskAwayChanged" Visibility="Collapsed" />
          </WrapPanel>
          </StackPanel>
         </Grid>
        </TabItem>
        <TabItem Header="Plan">
         <DataGrid x:Name="TaskPlanGrid" Margin="10">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Step" Binding="{Binding Key}" Width="80" />
           <DataGridTextColumn Header="Task" Binding="{Binding Request}" Width="*" />
           <DataGridTextColumn Header="Executed by" Binding="{Binding Executor}" Width="220" />
           <DataGridTextColumn Header="Skill" Binding="{Binding SkillId}" Width="180" />
           <DataGridTextColumn Header="Action type" Binding="{Binding Kind}" Width="130" />
           <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="130" />
           <DataGridTextColumn Header="After step" Binding="{Binding After}" Width="100" />
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <TabItem x:Name="CommentsTab" Header="Comments">
         <DockPanel x:Name="CommentPanel" Margin="10" />
        </TabItem>
       </TabControl>
       <Expander x:Name="TaskAiActions" Grid.Row="1" Header="Choose the AI for this task" Margin="4,0,0,12" Foreground="#B8B0CF" Visibility="Collapsed">
        <Border Background="#1D1A2E" CornerRadius="10" Padding="14" Margin="0,10,4,0">
         <StackPanel>
          <WrapPanel>
           <StackPanel>
            <TextBlock Text="AI provider" Foreground="#B8B0CF" />
            <ComboBox x:Name="RunProviderChoice" Width="180" DisplayMemberPath="Label" SelectionChanged="TaskProviderChanged" />
           </StackPanel>
           <StackPanel>
            <TextBlock Text="Model" Foreground="#B8B0CF" />
            <ComboBox x:Name="RouteChoice" Width="260" DisplayMemberPath="Label" />
           </StackPanel>
           <CheckBox x:Name="SwitchCoordinatorChoice" Content="Coordinator" VerticalAlignment="Bottom" ToolTip="Switch the planner; preserve accepted worker steps" />
           <Button Content="Switch AI" Click="SwitchWork" VerticalAlignment="Bottom" ToolTip="Run this task (or, with Coordinator ticked, its planner) with the AI chosen on the left." />
          </WrapPanel>
          <TextBlock Text="Automatic selection picks a model per step from its difficulty. Choose one here and press Switch AI to run the task with it instead." Foreground="#8F87A8" TextWrapping="Wrap" Margin="0,6,0,0" />
         </StackPanel>
        </Border>
       </Expander>
      </Grid>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="AI providers" x:Name="ProvidersTab">
    <Grid Margin="24">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
     </Grid.RowDefinitions>
     <DataGrid Grid.Row="1" x:Name="HealthGrid">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Provider" Binding="{Binding Id}" Width="90" />
       <DataGridCheckBoxColumn Header="Found" Binding="{Binding Installed}" Width="65" />
       <DataGridCheckBoxColumn Header="Ready" Binding="{Binding CanExecute}" Width="65" />
       <DataGridTextColumn Header="Auth" Binding="{Binding Authentication}" Width="80" />
       <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="80" />
       <DataGridTemplateColumn Header="Action" Width="200">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <Button Click="ProviderStatusAction" Loaded="ProviderStatusActionLoaded" Padding="10,4" Margin="3" MinHeight="30" />
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="Capabilities / limitations" Binding="{Binding Detail}" Width="*" />
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel>
      <Button Content="Configure AI &amp; models" Click="OpenSectionSettings" Tag="AI" />
      <Button Content="Check CLI status" Click="DetectProviders" />
     </WrapPanel>
    </Grid>
   </TabItem>
   <TabItem x:Name="SettingsTab" Header="Settings">
    <DockPanel Margin="18">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="All settings are grouped by section. Save buttons keep existing data and permissions." TextWrapping="Wrap" Margin="0,8,0,12" />
     </StackPanel>
     <TabControl TabStripPlacement="Left" x:Name="SettingsSections">
      <TabItem Header="Virtual Office" MinWidth="170" x:Name="SettingsOfficeSection">
       <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
        <TextBlock Text="Virtual Office" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock Text="Choose how the Virtual Office is shown. Tasks and AI keep running when it is off." TextWrapping="Wrap" Margin="0,0,0,12" />
        <RadioButton x:Name="OfficeFullChoice" Content="Full" GroupName="OfficeMode" Checked="OfficeModeChanged" Margin="0,4" />
        <RadioButton x:Name="OfficeOffChoice" Content="Off" GroupName="OfficeMode" Checked="OfficeModeChanged" Margin="0,4" />
       </StackPanel>
      </TabItem>
      <TabItem Header="General &amp; data" MinWidth="170" x:Name="SettingsGeneralSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <TextBlock Text="Your data stays on this PC" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,8" />
         <TextBlock x:Name="DataLocation" TextWrapping="Wrap" />
         <Button x:Name="ChangeDataButton" Content="Change data folder..." Click="ChangeDataFolder" HorizontalAlignment="Left" Margin="0,10,0,8" />
         <TextBlock Text="Copy tasks, checkpoints, history and settings to an empty folder and switch immediately. The old copy is kept for recovery." TextWrapping="Wrap" Foreground="#B8B0CF" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Projects" MinWidth="170" x:Name="SettingsProjectsSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <TextBlock Text="Select an existing project to manage its memory, or enter a folder/name/alias to register a new project." TextWrapping="Wrap" Margin="0,8,0,12" />
         <ComboBox DisplayMemberPath="Name" SelectionChanged="SettingsProjectChanged" x:Name="SettingsProjectChoice" />
         <StackPanel>
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
           </Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Project folder" />
            <TextBox x:Name="ProjectPath" />
           </StackPanel>
           <StackPanel Grid.Column="1">
            <TextBlock Text="Name" />
            <TextBox x:Name="ProjectName" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="Aliases (comma separated)" />
            <TextBox x:Name="ProjectAliases" />
           </StackPanel>
          </Grid>
          <WrapPanel>
           <Button Content="Choose folder" Click="BrowseProject" />
           <Button Content="Register project" Click="AddProject" Background="#7545D6" Foreground="White" />
           <Button Content="Choose folder and scan projects..." Click="ScanProjects" ToolTip="Scan subfolders and register detected projects. Skip existing projects and dependency/build folders. Stop descending when a project root is found." />
           <Button Content="Update file index" Click="IndexProject" />
           <Button Content="Scan project keywords" Click="ScanProjectKeywords" ToolTip="Refresh local discovery keywords from paths, root README and manifests." />
           <Button Content="Delete project" Click="DeleteProject" Foreground="#FF8D9D" ToolTip="Remove registration and management data; keep the source folder." />
          </WrapPanel>
         </StackPanel>
         <Expander Header="Project memory" IsExpanded="True">
          <StackPanel>
           <ListBox x:Name="MemoryList" DisplayMemberPath="Text" Height="85" SelectionChanged="MemorySelected" />
           <TextBox x:Name="MemoryText" AcceptsReturn="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto" />
           <WrapPanel>
            <Button Content="Save memory" Click="SaveProjectMemory" />
            <Button Content="Delete selected memory" Click="DeleteProjectMemory" />
           </WrapPanel>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Tasks" MinWidth="170" x:Name="SettingsTasksSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <TextBlock Text="Task assignment" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10" />
         <CheckBox x:Name="AutoAssignTask" Content="Automatic project and task type" ToolTip="Find the project by name, alias, folder or scanned keywords in your request. If no unique match is found, you will be asked to choose. Uncheck to select manually." IsChecked="True" Checked="AutoAssignmentChanged" Unchecked="AutoAssignmentChanged" />
         <TextBlock Text="Applies to new tasks immediately. Turn off automatic assignment to show manual project, type, access and advanced options in Create task." TextWrapping="Wrap" />
         <TextBlock Text="Task retention" FontSize="21" FontWeight="SemiBold" Margin="0,20,0,10" />
         <TextBlock Text="Remove tasks older than this many days from their creation time. Running tasks, sessions and tests are protected. Cleanup runs at startup and hourly." TextWrapping="Wrap" />
         <WrapPanel>
          <TextBox x:Name="TaskRetentionDays" Width="100" ToolTip="Whole days, 1?3650; default 7" />
          <Button Content="Save task retention" Click="SaveTaskRetention" />
         </WrapPanel>
         <TextBlock Text="Automatic task execution" FontSize="21" FontWeight="SemiBold" Margin="0,20,0,10" />
         <TextBlock Text="These defaults apply to new tasks. Small tasks run directly; work with multiple steps is planned and orchestrated within the same task." TextWrapping="Wrap" />
         <WrapPanel>
          <StackPanel>
           <TextBlock Text="Planning" />
           <ComboBox x:Name="AutoPlanning" Width="190" DisplayMemberPath="Label" />
          </StackPanel>
          <StackPanel>
           <TextBlock Text="Coordinator (automatic if empty)" />
           <ComboBox x:Name="AutoCoordinator" Width="300" DisplayMemberPath="Label" />
          </StackPanel>
         </WrapPanel>
         <WrapPanel>
          <StackPanel>
           <TextBlock Text="Minutes (0 = unlimited)" />
           <TextBox x:Name="AutoDuration" Width="120" />
          </StackPanel>
          <StackPanel>
           <TextBlock Text="AI calls / task (0 = unlimited)" />
           <TextBox x:Name="AutoCalls" Width="140" ToolTip="0 = unlimited (default)" />
          </StackPanel>
          <StackPanel>
           <TextBlock Text="Open steps (0 = unlimited)" />
           <TextBox x:Name="AutoTasks" Width="110" ToolTip="0 = unlimited (default). Large goals are planned phase by phase." />
          </StackPanel>
          <StackPanel>
           <TextBlock Text="Delegation depth" />
           <TextBox x:Name="AutoDepth" Width="120" />
          </StackPanel>
         </WrapPanel>
         <WrapPanel>
          <CheckBox x:Name="AutoDelegation" Content="Allow AI delegation proposals" />
          <CheckBox x:Name="AutoContinue" Content="Continue successful steps automatically; review final result" />
          <CheckBox x:Name="AutoAway" Content="Away by default" />
          <CheckBox x:Name="AutoTests" Content="Build and test after code steps (fix failures automatically)" ToolTip="After code steps finish, build/test the project with its test command (Settings → Tests) or a detected one (Unity script compile, dotnet build/test, node --test, pytest). Failures become fix steps." />
         </WrapPanel>
         <WrapPanel>
          <TextBlock Text="Enable Away after this many minutes of inactivity in the app (0 = off):" VerticalAlignment="Center" />
          <TextBox x:Name="AutoIdleMinutes" Width="80" />
         </WrapPanel>
         <Button Content="Save automation defaults" Click="SaveAutomation" HorizontalAlignment="Left" />
         <TextBlock Text="Each task's type/access, schedule and AI override are still chosen when you assign it. Intent memory is managed per task/project." TextWrapping="Wrap" Margin="0,8,0,12" />
         <Button Content="Manage intent learning for the selected task" Click="TeachTaskIntent" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Agents &amp; resources" MinWidth="170" x:Name="SettingsAgentsSection">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1150" HorizontalAlignment="Stretch">
         <StackPanel>
          <TextBlock Text="Concurrent agents (1-4)" />
          <TextBox x:Name="ParallelAgents" Width="130" />
         </StackPanel>
         <CheckBox x:Name="AdaptiveSlots" Content="Adapt agent slots to free RAM" />
         <StackPanel>
          <TextBlock Text="Free RAM reserve (MB)" />
          <TextBox x:Name="MemoryReserve" Width="150" />
         </StackPanel>
         <TextBlock x:Name="ResourceStatus" TextWrapping="Wrap" Margin="0,6,0,8" />
         <Button Content="Save agent &amp; RAM settings" Click="SaveAgentSectionSettings" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>
