<UserControl x:Class="Employee.Desktop.TestSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,12,0,0">
  <TextBlock Text="Testing" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="Choose the project and task that receive results. Full test runs every permitted suite; updated-part test uses paths from the task's edit proposal. Execution scope is decided by the suite's commands." TextWrapping="Wrap"/>
  <TextBlock Text="Task receiving results"/><ComboBox x:Name="TargetTasks" DisplayMemberPath="Request"/>
  <WrapPanel><Button Content="Test everything" Click="RunFull"/><Button Content="Test updated parts" Click="RunUpdated"/><Button Content="Run selected suite" Click="RunSelected"/></WrapPanel>
  <WrapPanel><Button Content="Generate suite with AI…" Click="Generate"/><Button Content="Update suite with AI…" Click="GenerateUpdate"/></WrapPanel>
  <TextBlock Text="Generate/update opens a draft Review task with project read access. Check the request and submit it in Tasks; when it returns, import the JSON here to view, edit and allow running." TextWrapping="Wrap"/>
  <TextBlock Text="Enabled commands are batched and run in Tasks. Only allow commands for trusted projects; AI cannot create executable commands." TextWrapping="Wrap"/>
  <WrapPanel><StackPanel><TextBlock Text="Project"/><ComboBox x:Name="Projects" Width="210" DisplayMemberPath="Name" SelectionChanged="ProjectChanged"/></StackPanel><StackPanel><TextBlock Text="Test suite name"/><TextBox x:Name="ProfileName" Width="180"/></StackPanel><StackPanel><TextBlock Text="Executable .exe"/><TextBox x:Name="Executable" Width="270"/></StackPanel><StackPanel><TextBlock Text="Timeout (seconds)"/><TextBox x:Name="Timeout" Text="300" Width="90"/></StackPanel></WrapPanel>
  <TextBlock Text="Arguments JSON, e.g. [ &quot;test&quot;, &quot;--no-restore&quot;, &quot;-c&quot;, &quot;Debug&quot; ]"/><TextBox x:Name="Arguments" Text="[]"/>
  <TextBlock Text="Related source paths (one file/folder per line, relative to the project; blank = always run on updated-part tests)" TextWrapping="Wrap"/><TextBox x:Name="SourcePaths" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto"/>
  <WrapPanel><CheckBox x:Name="Enabled" Content="Allow execution"/><CheckBox x:Name="Full" Content="Passing marks Verified within test scope"/><Button Content="Save configuration" Click="Save"/><Button Content="New test suite" Click="NewProfile"/></WrapPanel>
  <DataGrid x:Name="Profiles" Height="120" SelectionChanged="ProfileSelected"><DataGrid.Columns><DataGridTextColumn Header="Test suite" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Executable" Binding="{Binding Executable}" Width="280"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/></DataGrid.Columns></DataGrid>
  <Expander Header="Import / view / edit suite JSON"><StackPanel><TextBox x:Name="SuiteJson" Height="150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="Import JSON file" Click="ImportSuite"/><Button Content="View selected suite JSON" Click="ShowSuite"/><Button Content="Save JSON as new suite (not yet allowed to run)" Click="SaveSuite"/><Button Content="Export JSON" Click="ExportSuite"/></WrapPanel></StackPanel></Expander>
  <WrapPanel Margin="0,12,0,0"><Button Content="Queue tests for selected task" Click="Queue"/><Button Content="Run pending tests" Click="Run"/><Button Content="Retry selected job" Click="Retry"/><Button Content="Stop tests" Click="Stop"/></WrapPanel>
  <DataGrid x:Name="Jobs" Height="130" SelectionChanged="JobSelected"><DataGrid.Columns><DataGridTextColumn Header="Job" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Change impact" Binding="{Binding Impact}" Width="140"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/></DataGrid.Columns></DataGrid>
  <TextBox x:Name="Output" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="Notice" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
